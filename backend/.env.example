# Inventarios Mahoraga - Variables de Entorno (Backend 1)
NODE_ENV=development
PORT=4000
API_PREFIX=/api

# Base de datos (SQLite en dev/test, PostgreSQL en producción)
SQLITE_PATH=./data/mahoraga_dev.sqlite
# DATABASE_URL=postgres://usuario:password@localhost:5432/mahoraga_inventory

# Seguridad y JWT
JWT_ACCESS_SECRET=clave_secreta_super_segura_para_access_tokens_2026_mahoraga
JWT_REFRESH_SECRET=clave_secreta_super_segura_para_refresh_tokens_2026_mahoraga
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=secreto_para_firmado_de_cookies_http_only_inventario

# CORS
CORS_ORIGIN=http://localhost:5173

# Correo y SMTP (Nodemailer - Brevo / Resend / Mailtrap)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=tu_usuario_smtp
SMTP_PASS=tu_password_smtp
EMAIL_FROM="Inventarios Mahoraga" <soporte@mahoraga.local>
APP_URL=http://localhost:5173

# Almacenamiento de archivos
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

