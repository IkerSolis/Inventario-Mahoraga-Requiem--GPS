{
  "name": "inventarios-mahoraga-backend",
  "version": "1.0.0",
  "description": "API REST Backend para Inventarios Mahoraga / OmniStock Pulse - Módulo Backend 1 (Autenticación, Usuarios, Roles R0-R7, Dashboard y Configuración)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "knex --knexfile knexfile.js migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.js migrate:rollback",
    "seed": "knex --knexfile knexfile.js seed:run",
    "test": "node --test tests/**/*.test.js",
    "test:auth": "node --test tests/auth.test.js",
    "test:users": "node --test tests/users.test.js",
    "test:roles": "node --test tests/roles.test.js",
    "test:dashboards": "node --test tests/dashboards.test.js",
    "test:settings": "node --test tests/settings.test.js",
    "test:fase3": "node --test tests/fase3.test.js",
    "lint": "eslint src/ tests/",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\""
  },
  "keywords": [
    "inventory",
    "mahoraga",
    "omnistock",
    "express",
    "knex",
    "sqlite",
    "postgresql",
    "rbac"
  ],
  "author": "Inventarios Mahoraga Development Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0",
    "pg": "^8.13.3",
    "sqlite3": "^5.1.7",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "eslint": "^9.21.0",
    "prettier": "^3.5.2",
    "supertest": "^7.0.0"
  }
}

